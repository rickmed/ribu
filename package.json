{
	"name": "ribu",
	"description": "A Concurrency Library for Javascript",
	"version": "0.1.2",
	"type": "module",
	"engines": {
		"npm": "please-use-bun",
		"yarn": "please-use-bun",
		"pnpm": "please-use-bun",
		"bun": "1.2.x"
	},
	"files": [
		"source",
		"test-utils"
	],
	"exports": {
		".": {
			"import": "./source/index.ts"
		}
	},
	"scripts": {
		"test": "clear; vitest --run --no-cache --no-isolate",
		"test:watch": "clear; DEBUG=true vitest --no-cache --no-isolate",
		"test:cov": "cross-env 'NODE_OPTIONS=--import @istanbuljs/esm-loader-hook --no-warnings' nyc npm test",
		"type-check": "tsc --noEmit",
		"build": "rm -rf dist; tsc",
		"preinstall": "node scripts/preinstall.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.22.0",
		"@types/eslint__js": "^9.14.0",
		"@types/node": "^22.13.10",
		"eslint": "^9.22.0",
		"eslint-plugin-functional": "^9.0.1",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"vitest": "3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rickmed/ribu"
	},
	"issues": "https://github.com/rickmed/ribu/issues",
	"license": "MIT",
	"author": {
		"name": "Ricardo Medina"
	}
}